# LinguaLayer API
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Postgres. Read by Prisma (prisma/schema.prisma) and by the pg pool in
# src/db/client.ts, which falls back to this same database when unset.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lingualayer

# REDIS_URL=redis://localhost:6379

# Rate limiting (per minute, per IP or JWT subject)
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_TX_MAX=10
RATE_LIMIT_UPLOAD_MAX=20

# Stellar / Soroban
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
DATASET_REGISTRY_CONTRACT_ID=
LICENSE_CONTRACT_ID=

# SEP-0010 Web Authentication (GET /auth/challenge, POST /auth/token)
SEP10_SERVER_SECRET=
SEP10_HOME_DOMAIN=lingualayer.app
SEP10_WEB_AUTH_DOMAIN=
SEP10_CHALLENGE_TIMEOUT_SECONDS=300
JWT_SECRET=
JWT_TTL_SECONDS=3600

# DataCommission event indexer (GET /commissions, GET /commissions/:id)
DATA_COMMISSION_CONTRACT_ID=
COMMISSION_INDEXER_POLL_INTERVAL_MS=5000

# Commission fulfilment notification emails (POST /commissions/:id/fulfil)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@lingualayer.app
